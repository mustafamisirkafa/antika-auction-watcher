# Antika Auction Watcher - Environment Configuration Template
# Copy this file to .env and fill in your values

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/antika_auction
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://localhost:6379/0

# Sprint 1: Redis Sentinel Configuration (optional, for HA)
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
REDIS_SENTINEL_MASTER=mymaster

# ========================================
# Security Configuration (Sprint 2)
# ========================================

# Encryption (REQUIRED)
# Generate with: python -m backend.core.encryption generate
MASTER_KEY=your-base64-encoded-fernet-key-here

# Legacy keys for decryption during key rotation (comma-separated)
LEGACY_KEYS=

# JWT Authentication (REQUIRED)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_HOURS=24

# ========================================
# CORS Configuration
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ========================================
# Application Settings
# ========================================
ENVIRONMENT=development
API_TITLE=Antika Auction Watcher
API_VERSION=1.0.0
API_PREFIX=/api/v1

# Default language (Sprint 16-TR)
DEFAULT_LANGUAGE=tr

# ========================================
# Rate Limiting (Sprint 2)
# ========================================
RATE_LIMIT_ENABLED=true

# ========================================
# Observability (Sprint 3 - coming soon)
# ========================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
LOG_LEVEL=INFO

# ========================================
# External APIs (encrypt with MASTER_KEY before storing in DB)
# ========================================
# These are examples - actual keys should be stored encrypted in database
# EBAY_API_KEY=your-ebay-key
# ETSY_API_KEY=your-etsy-key
# INSTAGRAM_ACCESS_TOKEN=your-instagram-token

# ========================================
# Performance Tuning
# ========================================
CACHE_TTL_SECONDS=600
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30

# ========================================
# Development Tools
# ========================================
DEBUG=false
RELOAD=false  # Auto-reload on code changes (dev only)
