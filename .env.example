# Database Configuration
DATABASE_URL=postgresql://antika:antika_password@localhost:5432/antika_auction

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Encryption (32 bytes base64 encoded)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Instagram Credentials (Optional for Phase 1)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Phase 2: eBay API Credentials
EBAY_APP_ID=your-ebay-app-id-here
EBAY_CERT_ID=your-ebay-cert-id-here
EBAY_DEV_ID=your-ebay-dev-id-here
EBAY_OAUTH_TOKEN=your-ebay-oauth-token-here

# Phase 2: Etsy API Credentials
ETSY_API_KEY=your-etsy-api-key-here
ETSY_SECRET_KEY=your-etsy-secret-key-here
ETSY_OAUTH_TOKEN=your-etsy-oauth-token-here

# Phase 2: Admin & Configuration
ADMIN_SECRET_KEY=your-admin-secret-key-here
RATE_LIMIT_ENABLED=true
CACHE_TTL_SECONDS=3600
