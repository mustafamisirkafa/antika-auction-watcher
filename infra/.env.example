# Antika Auction Watcher - Production Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
POSTGRES_DB=antika_db
POSTGRES_USER=antika_user
POSTGRES_PASSWORD=<generate-strong-password-32-chars>

# Redis Configuration
REDIS_PASSWORD=<generate-strong-password-32-chars>

# Application Configuration
SECRET_KEY=<generate-secret-key-50-chars>
ENVIRONMENT=production
LOG_LEVEL=INFO

# Domain Configuration
DOMAIN=your-domain.com
API_URL=https://your-domain.com/api/v1
WS_URL=wss://your-domain.com/api/v1/ws

# Monitoring Configuration
GRAFANA_PASSWORD=<admin-password-strong>

# Email/SMTP Configuration (for alerts)
SMTP_USERNAME=alerts@your-domain.com
SMTP_PASSWORD=<smtp-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: External Services
# SENTRY_DSN=https://...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# Security
# JWT_EXPIRY_MINUTES=15
# REFRESH_TOKEN_EXPIRY_DAYS=7
# BCRYPT_COST_FACTOR=12
